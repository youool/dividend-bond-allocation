# 环境与缓存
.venv/
__pycache__/
*.pyc
.ipynb_checkpoints/
.DS_Store

# 工具自身的项目数据，与策略无关
.workbuddy/

# 运行日志与临时文件
output/*.log
output/*.txt
*.tmp
~$*
report/_backup*.docx

# PPT 生成工具的缓存与日志
.slidep/
.cache/

# 本地交付物（旧版临时 zip 不进仓库）
report/*.zip
