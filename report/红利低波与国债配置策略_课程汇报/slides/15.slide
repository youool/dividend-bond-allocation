        { text: 'Calmar', textStyle: { bold: true, color: '#FFFFFF' }, cellStyle: { background: { color: '#1A3D6D' } } },
      ],
      [
        { text: '本策略', textStyle: { bold: true, textAlign: 'left' } },
        { text: '69.0%', textStyle: { bold: true, color: '#1A3D6D' } },
