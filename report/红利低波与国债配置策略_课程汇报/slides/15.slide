      [{ text: '红利低波买入持有', textStyle: { textAlign: 'left' } }, { text: '147.0%', textStyle: { color: '#8B2E2E' } }, { text: '12.8%', textStyle: { color: '#8B2E2E' } }, '−16.5%', '0.68', '0.77'],
      [
