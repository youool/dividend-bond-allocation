    </Box>

    <Box style={{ flexDirection: 'column', alignItems: 'center', width: 736 }}>
      <Image src="assets/board.png" style={{ width: 700, height: 437, objectFit: 'contain' }} />
      <Text style={{ fontSize: 14, color: '#8B97A8', marginTop: 4 }}>
        本地看板：目标波动 8% 对应 8.41%／−6.54%，拉到 12% 立刻变成 9.44%／−8.10%
      </Text>
    </Box>
  </Box>
</Slide>
